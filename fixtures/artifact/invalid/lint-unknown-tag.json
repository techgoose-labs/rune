{
  "name": "Test",
  "schemaVersion": "2.0.0",
  "tags": [
    {
      "id": "dto",
      "tag": "[DTO]",
      "label": "DTO",
      "indent": 0,
      "follows": "dtodef",
      "shapeRule": "dto-suffix"
    },
    {
      "id": "ply",
      "tag": "[PLY]",
      "label": "Poly",
      "indent": 4,
      "follows": "poly",
      "shapeRule": "dto-suffix"
    },
    {
      "id": "cse",
      "tag": "[CSE]",
      "label": "Case",
      "indent": 8,
      "follows": "case",
      "shapeRule": "dto-suffix"
    }
  ],
  "modifiers": [
    {
      "id": "core",
      "token": ":core",
      "appliesTo": [
        "dto"
      ],
      "kind": "routing",
      "base": null,
      "param": "none"
    }
  ],
  "builtins": [
    "string"
  ],
  "tokens": {},
  "lint": [
    {
      "id": "dto-suffix",
      "type": "name-suffix",
      "target": "spec",
      "severity": "error",
      "enabled": true,
      "params": {
        "tag": "ghost"
      },
      "message": "x"
    }
  ],
  "transports": [
    {
      "id": "HTTP",
      "summary": "http"
    }
  ],
  "faults": {
    "marker": "!",
    "syntax": "! name",
    "shape": "^[a-z][a-z0-9-]*$",
    "summary": "faults",
    "wellKnown": [
      {
        "id": "not-found",
        "status": 404,
        "summary": "missing"
      }
    ]
  },
  "indent": {
    "unit": 4,
    "step": 4,
    "fault": 6,
    "case": 8,
    "caseStep": 8,
    "caseFault": 10,
    "description": 4,
    "body": 4,
    "faultOffset": 2
  },
  "columns": {
    "max": 80
  }
}
