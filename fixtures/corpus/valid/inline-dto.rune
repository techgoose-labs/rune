[REQ] search.run({query, page}): ResultsDto
    db:index.query(query, page): ResultsDto
      ! timeout

[DTO] ResultsDto: items
    the matched results

[TYP] query: string
    the query
[TYP] page: number
    the page
[TYP] items: string
    the items

[SRV] (SIDECAR)db: DB_URL
    the primary datastore
    @docs https://docs.example.com/db
