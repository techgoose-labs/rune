[REQ] account.open(OpenDto): AccountDto
    id::create(OpenDto): IdDto
    [NEW] account
    account.activate(IdDto): AccountDto
      ! already-active=409

[NON] account
    a customer account
[NON] id
    an identity minted for a new account

[DTO] OpenDto: name
    a request to open an account

[DTO] IdDto: id
    a generated identifier

[DTO] AccountDto: id, name
    an opened account

[TYP] name: string
    the name
[TYP] id: string
    the id
