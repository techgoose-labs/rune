[MOD] lists

[REQ] list.create(CreateListDto): ListDto
    id::generate(): id
    [NEW] list
    list.fill(id, name): list
    list.toDto(): ListDto
    db:list.save(ListDto): void
      ! timeout
    [RET] ListDto

[REQ] list.addTask(AddTaskDto): ListDto
    db:list.load(id): ListDto as stored
      ! not-found
    list::fromDto(stored): list
    list.append(taskId): list
    list.toDto(): ListDto
    db:list.save(ListDto): void
      ! timeout
    [RET] ListDto

[TYP] id: string
    a unique list identifier
[TYP:example=groceries] name: string
    the list name
[TYP] taskId: string
    an id of a task placed on the list

[DTO] CreateListDto: name
    input to create a new list
[DTO] AddTaskDto: id, taskId
    input to add a task to a list
[DTO] ListDto: id, name, taskId(s)
    a persisted list record

[NON] list
    a named collection of tasks
