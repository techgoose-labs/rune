[MOD] todos

[REQ] todo.add(CreateTodoDto): TodoDto
    id::generate(): id
    [NEW] todo
    todo.fill(id, title): todo
    todo.toDto(): TodoDto
    db:todo.save(TodoDto): void
      ! timeout
    [RET] TodoDto

[REQ] todo.complete(TodoRefDto): TodoDto
    db:todo.load(id): TodoDto as stored
      ! not-found
    todo::fromDto(stored): todo
    todo.markDone(): todo
    todo.toDto(): TodoDto
    db:todo.save(TodoDto): void
      ! timeout
    [RET] TodoDto

[REQ] todo.discard(TodoRefDto): TodoDto
    db:todo.load(id): TodoDto as stored
      ! not-found
    todo::fromDto(stored): todo
    todo.archive(): todo
    todo.toDto(): TodoDto
    db:todo.save(TodoDto): void
      ! timeout
    [RET] TodoDto

[REQ] list.create(CreateListDto): ListDto
    id::generate(): id
    [NEW] list
    list.fill(id, name): list
    list.toDto(): ListDto
    db:list.save(ListDto): void
      ! timeout
    [RET] ListDto

[TYP] id: string
    a unique identifier
[TYP:example=buy-milk] title: string
    the human-readable todo title
[TYP:example=home] name: string
    the human-readable list name
[TYP] done: boolean
    whether the todo is done

[DTO] CreateTodoDto: title
    input to create a new todo
[DTO] TodoRefDto: id
    a reference to an existing todo
[DTO] TodoDto: id, title, done
    a persisted todo item
[DTO] CreateListDto: name
    input to create a new list
[DTO] ListDto: id, name
    a persisted todo list

[NON] todo
    a single todo item
[NON] list
    a named collection of todos
