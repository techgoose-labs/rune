[MOD] tasks

[REQ] task.create(CreateTaskDto): TaskDto
    id::generate(): id
    [NEW] task
    task.fill(id, title): task
    task.toDto(): TaskDto
    db:task.save(TaskDto): void
      ! timeout
    [RET] TaskDto

[REQ] task.complete(TaskRefDto): TaskDto
    db:task.load(id): TaskDto as stored
      ! not-found
    task::fromDto(stored): task
    task.markDone(): task
    task.toDto(): TaskDto
    db:task.save(TaskDto): void
      ! timeout
    [RET] TaskDto

[TYP] id: string
    a unique task identifier
[TYP:example=buy-milk] title: string
    the human-readable task title
[TYP] done: boolean
    whether the task has been completed

[DTO] CreateTaskDto: title
    input to create a new task
[DTO] TaskRefDto: id
    a reference to an existing task
[DTO] TaskDto: id, title, done
    a persisted task record

[NON] task
    a single todo item
